# Leave both empty to run on the demo catalogue (src/lib/commerce/catalogue.ts).
# Fill both to run on Shopify — see SHOPIFY.md.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
# Optional. Storefront API version.
# SHOPIFY_API_VERSION=2026-07

# Optional. Public URL the site is served from — used for link previews.
# SITE_URL=https://93plus.shop

# ── Shop editor (/admin) ─────────────────────────────────────────────
# The one password that opens the editor. Required — without it /admin stays locked.
# ADMIN_PASSWORD=
# Optional extra secret mixed into the sign-in cookie. Changing it signs everyone out.
# ADMIN_SECRET=

# Where the editor's changes, uploaded photos and orders are kept.
# Automatic: Netlify Blobs on Netlify, the .data/ folder anywhere else.
# STORE=file|netlify
# DATA_DIR=/var/lib/93plus

# ── Orders ───────────────────────────────────────────────────────────
# The Google Sheet web app from ORDERS.md. Without it orders are kept in the
# store only (still trackable on /order).
# ORDERS_WEBHOOK_URL=
# ORDERS_WEBHOOK_SECRET=
